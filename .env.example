# Copy this file to .env.local and fill in your real values.
# Everything here is OPTIONAL — the site works with placeholder
# values from src/config/site.ts if you skip this file entirely.

# Formspree form endpoint (https://formspree.io) — powers the Contact section.
# If set, this overrides contact.formspreeEndpoint in src/config/site.ts.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Vercel Analytics is auto-enabled when deployed on Vercel — no key needed.
